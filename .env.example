# ── Supabase ──────────────────────────────────────────────────────────────
# URL del proyecto (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (pública; la protege RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
